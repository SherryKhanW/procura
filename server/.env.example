# Copy to server/.env. This file contains EXAMPLES, not working credentials.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=procura
DB_USER=procura_app
DB_PASSWORD=
# Use true for the hosted database; certificate verification stays enabled.
DB_SSL=false
# Optional absolute path to a provider CA certificate.
DB_SSL_CA=
