# Copy to server/.env. This file contains EXAMPLES, not working credentials.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Exact browser origin, without trailing slash. Use the Vite URL locally.
APP_ORIGIN=http://127.0.0.1:5173
# Keep 0 locally. Set only for a known, trusted reverse proxy in deployment.
TRUST_PROXY_HOPS=0
DB_HOST=mysql-procura.alwaysdata.net
DB_PORT=3306
DB_NAME=procura_db
DB_USER=procura_app
DB_PASSWORD=
# Hosted connections use TLS with certificate verification enabled.
# For a separate local database only, use its local host/name and DB_SSL=false.
DB_SSL=true
# Optional absolute path to a provider CA certificate.
DB_SSL_CA=
