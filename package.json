{
  "name": "procura",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:check": "npm run db:check -w server",
    "auth:set-password": "npm run auth:set-password -w server",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
